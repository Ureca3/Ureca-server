<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ureca.unity.domain.stt.mapper.SttMapper">

    <resultMap id="sttJobMap" type="com.ureca.unity.domain.stt.model.SttJob">
        <id property="sttJobId" column="stt_job_id"/>
        <result property="counselingId" column="counseling_id"/>
        <result property="userId" column="user_id"/>
        <result property="summaryType" column="summary_type"/>
        <result property="status" column="status"/>
        <result property="summaryText" column="summary_text"/>
        <result property="keywords" column="keywords"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByCounselingId" resultMap="sttJobMap">
        SELECT *
        FROM stt_jobs
        WHERE counseling_id = #{counselingId}
    </select>

    <select id="findById" resultMap="sttJobMap">
        SELECT *
        FROM stt_jobs
        WHERE stt_job_id = #{sttJobId}
    </select>

    <insert id="insert"
            parameterType="com.ureca.unity.domain.stt.model.SttJob"
            useGeneratedKeys="true"
            keyProperty="sttJobId">
        INSERT INTO stt_jobs (
            counseling_id,
            user_id,
            summary_type,
            status
        )
        VALUES (
                   #{counselingId},
                   #{userId},
                   #{summaryType},
                   #{status}
               )
    </insert>

    <update id="updateResult"
            parameterType="com.ureca.unity.domain.stt.model.SttJob">
        UPDATE stt_jobs
        SET
            status = #{status},
            summary_text = #{summaryText},
            updated_at = NOW()
        WHERE stt_job_id = #{sttJobId}
    </update>

</mapper>
